# Скопируйте в .env и заполните значения: cp .env.example .env

# --- nginx: порт, на котором API доступно на хосте (http://localhost:PORT/api/docs)
PORT=8080

# --- PostgreSQL
DB_USER=catalogue
DB_PASSWORD=CHANGEME
DB_NAME=catalogue
DB_SCHEMA=public

# --- Авторизация
# openssl rand -hex 32
JWT_SECRET_KEY=CHANGEME
# токен бота из @BotFather: по нему проверяется подпись initData Mini App
TELEGRAM_BOT_TOKEN=CHANGEME

# --- CORS (JSON-список origin'ов)
SERVER_ALLOWED_ORIGINS=["https://your-mini-app.example"]

# --- pgAdmin (только с профилем tools: make pgadmin)
# PGADMIN_EMAIL=admin@admin.com
# PGADMIN_PASSWORD=admin
# PGADMIN_PORT=5050
