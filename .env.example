# Скопируйте в .env и заполните значения: cp .env.example .env

# --- nginx: порт, на котором API доступно на хосте (http://localhost:PORT/api/docs)
PORT=8080

# --- PostgreSQL
DB_USER=catalogue
DB_PASSWORD=CHANGEME
DB_NAME=catalogue
DB_SCHEMA=public

# --- Redis (в нём лежат живые JWT): openssl rand -hex 16
REDIS_PASSWORD=change-me

# --- Авторизация
# openssl rand -hex 32
JWT_SECRET_KEY=CHANGEME
# токен бота из @BotFather: по нему проверяется подпись initData Mini App
TELEGRAM_BOT_TOKEN=CHANGEME

# --- CORS (JSON-список конкретных origin'ов, "*" запрещён)
SERVER_ALLOWED_ORIGINS=["https://your-mini-app.example"]

# --- pgAdmin (только с профилем tools: make pgadmin)
# PGADMIN_EMAIL=admin@admin.com
# PGADMIN_PASSWORD=задайте-свой
# PGADMIN_PORT=5050

# --- Swagger (/api/docs): по умолчанию выключен
# DOCS_ENABLED=true
